    {
      "id": "redact/emoji-before",
      "config": {
        "rules": {
          "email": {
            "action": "redact"
          },
          "ipv4": {
            "action": "redact"
          }
        }
      },
      "input": "😀 jane.doe@example.com",
      "expected": {
        "text": "😀 [EMAIL]",
        "groups": [
          {
            "start": 3,
            "end": 23,
            "replacement": "[EMAIL]",
            "matches": [
              {
                "start": 3,
                "end": 23,
                "ruleId": "email",
                "entityType": "email",
                "reasons": [
                  "email.ascii_dot_atom",
                  "email.dns_domain"
