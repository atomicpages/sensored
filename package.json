{
  "name": "sensored-monorepo",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "bun run --filter sensored build",
    "lint": "biome check . --diagnostic-level error",
    "format": "biome format . --write --unsafe",
    "test": "bun run --filter sensored test",
    "typecheck": "bun run --filter sensored typecheck",
    "typecheck:build": "bun run --filter sensored typecheck:build",
    "typecheck:test": "bun run --filter sensored typecheck:test",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "husky",
    "audit": "bun audit --ignore GHSA-vfj7-8cjw-p6xm --ignore GHSA-ch52-4w7c-c8xp"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@faker-js/faker": "^10.6.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@speed-highlight/core": "^2.1.0",
    "@types/bun": "1.4.2",
    "@typesafe-ai/sdk": "^0.6.0",
    "citty": "^0.2.2",
    "commitizen": "^4.3.2",
    "compromise": "^14.17.0",
    "cz-conventional-changelog": "^3.3.0",
    "efrt": "^2.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "mitata": "^1.0.34",
    "prettier": "3.9.8",
    "publint": "^0.3.24",
    "semantic-release": "^25.0.9",
    "tsdown": "^0.23.0",
    "vitepress": "^2.0.0-alpha.20",
    "vitepress-plugin-llms": "^1.14.0",
    "wikidata-names": "^1.0.0"
  }
}
